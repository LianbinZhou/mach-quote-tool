{
  "name": "@usethink/mach-calculators",
  "version": "0.1.4",
  "description": "数控加工工时、切削参数、成本与报价计算器公式库",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": {
        "development": "./src/index.ts",
        "default": "./dist/index.js"
      }
    },
    "./formulas": {
      "types": "./dist/formulas/index.d.ts",
      "import": {
        "development": "./src/formulas/index.ts",
        "default": "./dist/formulas/index.js"
      }
    },
    "./schema": {
      "types": "./dist/schema/index.d.ts",
      "import": {
        "development": "./src/schema/index.ts",
        "default": "./dist/schema/index.js"
      }
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": {
        "development": "./src/adapters/index.ts",
        "default": "./dist/adapters/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "publish:dry-run": "publish-toolkit publish --dry-run --package-manager npm",
    "release": "publish-toolkit publish --package-manager npm",
    "prepublishOnly": "npm run type-check && npm test",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@usethink/publish-toolkit": "^0.1.15",
    "typescript": "^5.7.0",
    "vitest": "^3.2.6"
  }
}
